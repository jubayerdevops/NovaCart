variable "name_prefix" {
  description = "Prefix for resource names, e.g. novacart-dev."
  type        = string
}

variable "database_subnet_ids" {
  description = "Database subnets (at least 2 AZs) for the DB subnet group."
  type        = list(string)
}

variable "db_sg_id" {
  description = "Security group attached to the database."
  type        = string
}

variable "engine_version" {
  description = "MySQL major version."
  type        = string
  default     = "8.4"
}

variable "instance_class" {
  description = "RDS instance size."
  type        = string
  default     = "db.t3.micro"
}

variable "allocated_storage" {
  description = "Storage in GiB."
  type        = number
  default     = 20
}

variable "db_name" {
  description = "Name of the initial database."
  type        = string
  default     = "novacart"
}

variable "master_username" {
  description = "Master username (the password is generated by AWS)."
  type        = string
  default     = "novacart_admin"
}

# ---- Per-environment settings (dev vs prod) -------------------------
variable "multi_az" {
  description = "Run a standby replica in a second AZ."
  type        = bool
}

variable "deletion_protection" {
  description = "Block deletion of the database."
  type        = bool
}

variable "backup_retention_period" {
  description = "Days to keep automated backups (0 disables them)."
  type        = number
}

variable "skip_final_snapshot" {
  description = "Skip the final snapshot on delete (true for dev, false for prod)."
  type        = bool
}